# Supabase. For local development, run `supabase start` and copy the values from
# `supabase status` (API URL, anon key, service_role key) into .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the seed script, the demo switcher, guest link re-sends and the Stripe webhook.
SUPABASE_SERVICE_ROLE_KEY=

# Secret that derives personal invitation links from their ids (lib/tokens.ts).
# Use a long random string in production; changing it changes every link the dashboard shows.
INVITE_TOKEN_SECRET=change-me-to-a-long-random-string

# Public URL of the site, used in auth emails. Defaults to the request's host.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (payments for plans and vendor tiers). Use test-mode keys (sk_test_…) until launch.
# Without STRIPE_SECRET_KEY, and with demo mode off, upgrades show "not available yet".
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (Dashboard → Developers → Webhooks), or the
# whsec_… that `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints.
STRIPE_WEBHOOK_SECRET=
# Optional Price ids. Without them Checkout uses the prices in lib/plans.ts.
# Plus/Signature: one-time prices. Featured/Spotlight: monthly recurring prices.
STRIPE_PRICE_PLUS=
STRIPE_PRICE_SIGNATURE=
STRIPE_PRICE_FEATURED=
STRIPE_PRICE_SPOTLIGHT=

# Demo mode: the /demo/* identity switcher, demo accounts on the sign-in page,
# instant plan/tier changes without payment, and the demo reset button.
# Leave unset (off) for a real deployment.
QUBOOL_DEMO=on
